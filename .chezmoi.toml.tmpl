# see: https://www.chezmoi.io/reference/configuration-file/variables/

progress = true

# NOTE: パッケージ一覧の本体は .chezmoidata/packages.yaml にある。
# ここには prompt の結果に依存して .chezmoidata に置けないものだけを残す。
# installExternal は promptBoolOnce の参照先。この値を書き出しておくことで
# chezmoi init を再実行しても前回の回答を引き継ぎ、再質問されない。
{{- $installExternal := promptBoolOnce . "brew.packages.cask.installExternal" "Do you want to install external casks" }}
[data.brew.packages.cask]
  installExternal = {{ $installExternal }}
{{- if $installExternal }}
  external = [
    "alt-tab",
    "cleanshot",
    "deepl",
    "raycast",
  ]
{{- else }}
  external = []
{{- end }}
{{/* linux は linuxbrew、macOS は Apple シリコン (arm64) と Intel (amd64) で brew のパスが異なる */ -}}
{{- $brewPath := "" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $brewPath = "/home/linuxbrew/.linuxbrew/bin/brew" -}}
{{- else if eq .chezmoi.arch "arm64" -}}
{{-   $brewPath = "/opt/homebrew/bin/brew" -}}
{{- else -}}
{{-   $brewPath = "/usr/local/bin/brew" -}}
{{- end }}
[data.brew]
  path = {{ $brewPath | quote }}

[edit]
{{ if lookPath "nvim" }}
  command = "nvim"
{{ else if lookPath "vim" }}
  command = "vim"
{{ end }}

[diff]
  exclude = ["scripts"]
