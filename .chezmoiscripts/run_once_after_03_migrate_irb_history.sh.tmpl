#!/bin/sh
set -eu

dest={{ .chezmoi.destDir | squote }}

state="$dest/.local/state"
old="$state/.irb_history"
new="$state/irb/history"

[ -f "$old" ] || exit 0

if [ -e "$new" ]; then
  echo "skip: $new が既にあるため $old は移動しない" >&2
  exit 0
fi

mkdir -p "$(dirname "$new")"
chmod 700 "$(dirname "$new")"
mv "$old" "$new"
chmod 600 "$new"
echo "moved: $old -> $new"
