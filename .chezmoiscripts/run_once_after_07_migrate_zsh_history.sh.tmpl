#!/bin/sh
set -eu

dest={{ .chezmoi.destDir | squote }}

state="$dest/.local/state"
old="$state/zsh_history"
new="$state/zsh/history"

[ -f "$old" ] || exit 0

if [ -e "$new" ]; then
  echo "skip: $new が既にあるため $old は移動しない" >&2
  exit 0
fi

mkdir -p "$state/zsh"
mv "$old" "$new"
chmod 600 "$new"
echo "moved: $old -> $new"

echo "note: 起動中の zsh は $old へ書き続ける。新しいシェルを開き直すこと" >&2
