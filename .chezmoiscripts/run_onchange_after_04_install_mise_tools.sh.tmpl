#!/bin/sh
set -eu

# mise activate の auto-install は対話シェルでしか効かないので、apply の中で mise install しておく。
# run_once_ は過去に実行した本文をすべて記憶していて、config を前のバージョンに戻したときに再実行されない。
# run_onchange_ にして、下のハッシュで config の変更を本文に反映させる。
# mise config: {{ include "dot_config/mise/config.toml" | sha256sum }}

if [ -x {{ .brew.path | squote }} ]
then
  eval "$({{ .brew.path }} shellenv)"
fi

if ! command -v mise >/dev/null 2>&1
then
  echo "mise command not found 😱"
  exit 1
fi

{{ if eq .chezmoi.os "linux" -}}
# ruby は mise (ruby-build) がソースからビルドするのでヘッダ類が要る
REQUIRED_PACKAGES="libyaml-dev libssl-dev zlib1g-dev libffi-dev libreadline-dev libgmp-dev"
MISSING_PACKAGES=""

for pkg in $REQUIRED_PACKAGES; do
    if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "ok installed"; then
        MISSING_PACKAGES="$MISSING_PACKAGES $pkg"
    fi
done

if [ -n "$MISSING_PACKAGES" ]; then
    echo "Installing missing packages:$MISSING_PACKAGES"
    # 新規環境ではパッケージリストが空なので update してから install する
    sudo apt-get update
    # shellcheck disable=SC2086
    sudo apt-get install -y $MISSING_PACKAGES
fi
{{- end }}

MISE_YES=1
export MISE_YES

mise install

echo "mise tools installation completed 🎉"
